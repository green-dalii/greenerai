---
import Base from '../layouts/Base.astro';
import { getDict } from '../i18n';

/* 全站唯一的双语同页：一个静态 404 要同时招呼两种语言的访客。
   文案仍走字典（components 内不写死文案），两份各取一半。 */
const en = getDict('en').notFound;
const zh = getDict('zh').notFound;
---

<!--
  真实的 404。之前没有这个文件，Cloudflare Pages 把所有未知路径回落到 index.html
  并返回 200 —— 即「软 404」：任何拼错的 URL 都变成首页的一份重复副本，可无限爬。
  这里必须同时给出状态码与去向。
-->
<Base title={en.title} description={en.body} noindex>
  <section class="relative overflow-hidden bg-paper-tint">
    <div class="container-site relative z-10 pt-24 pb-20 md:pt-32 md:pb-28">
      <span class="eyebrow block">{en.eyebrow}</span>

      <h1 class="t-hero mt-6 text-ink">{en.heading}</h1>

      <p class="t-lead mt-8 max-w-xl text-ink/85">{en.body}</p>

      <p lang="zh-CN" class="t-lead mt-4 max-w-xl text-ink/85">{zh.body}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a class="btn-primary" href="/">{en.home}</a>
        <a class="btn-secondary" href="/zh/">{zh.home}</a>
        <a class="btn-secondary" href="https://github.com/green-dalii" rel="noreferrer">
          GitHub
        </a>
      </div>

      <p class="mono-label mt-9 text-muted">{en.note}</p>
    </div>
  </section>
</Base>
