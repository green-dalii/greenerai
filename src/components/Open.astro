---
import { getDict } from '../i18n';
const o = getDict(Astro.currentLocale).open;
const links = [
  { label: o.cta1, href: o.cta1Href },
  { label: o.cta2, href: o.cta2Href },
  { label: o.cta3, href: o.cta3Href },
];
---

<!--
  全出血收束带：不再套一张圆角薄荷卡片 —— 卡片会把它降级成「又一个内容块」。
  整节贯穿视口宽度，是本页第二个、也是最后一个破格。
-->
<section id="open" class="bg-paper-tint pt-24 pb-24 md:pt-28 md:pb-32">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow block" data-reveal>{o.eyebrow}</span>
      <h2 class="t-h2 mt-5 text-ink" data-reveal data-reveal-delay="80">{o.heading}</h2>
      <p class="t-lead mt-6 text-ink/85" data-reveal data-reveal-delay="160">{o.body}</p>
    </div>

    <!-- 链接行：读源码 / 查数字 / 跑起来（编辑式列表，无图标按钮） -->
    <div class="mx-auto mt-14 max-w-xl" data-reveal data-reveal-delay="240">
      {
        links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noreferrer"
            class="group flex items-center justify-between gap-4 border-b border-rule-strong/60 py-4 transition-colors first:border-t hover:border-primary"
          >
            <span class="t-body font-medium text-ink transition-colors group-hover:text-primary">
              {l.label}
            </span>
            <span
              class="text-sm text-muted transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-primary"
              aria-hidden="true"
            >
              ↗
            </span>
          </a>
        ))
      }
    </div>

    <!-- 写信：地址本身就是按钮。
         原来是一个实心绿按钮 + 下面再印一遍 mono 地址 —— 同一个动作说两遍，
         而且把一个「写封信」的邀请做成了 SaaS 表单的收尾。现在让地址自己站出来。 -->
    <div class="mt-14 text-center" data-reveal data-reveal-delay="300">
      <span class="mono-label block text-muted">{o.email.label}</span>
      <a class="mail-cta mt-3 inline-block" href={o.email.href}>
        {o.email.href.replace('mailto:', '')}
      </a>
    </div>

    <p class="mono-label mt-14 text-center text-muted" data-reveal data-reveal-delay="360">
      {o.note}
    </p>
  </div>
</section>

<style>
  /* 地址即入口：衬线大字 + 虚线下划，悬停转实线并变主色。
     可复制、可点、不用按钮壳 —— 这是「找人聊」该有的分量。 */
  .mail-cta {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    text-decoration-color: color-mix(in oklab, var(--color-primary) 45%, transparent);
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }
  .mail-cta:hover,
  .mail-cta:focus-visible {
    color: var(--color-primary);
    text-decoration-style: solid;
    text-decoration-color: var(--color-primary);
  }
</style>
