---
import { getDict } from '../i18n';
import ProofCard from './ProofCard.astro';
import Ledger from './Ledger.astro';
const p = getDict(Astro.currentLocale).practice;
const cards = p.cards;
const ordinals = ['01', '02', '03', '04'];
---

<section id="proof" class="bg-paper pt-14 pb-0 md:pt-16">
  <div class="container-site">
    <div class="max-w-[34rem]">
      <span class="eyebrow block" data-reveal>{p.eyebrow}</span>
      <h2 class="t-h2 mt-4 text-ink" data-reveal data-reveal-delay="80">{p.heading}</h2>
      <p class="t-body mt-5 text-ink/80" data-reveal data-reveal-delay="160">{p.sub}</p>
    </div>

    <div class="mt-14 md:mt-16">
      {
        cards.map((card, i) => (
          <ProofCard
            card={card}
            ordinal={ordinals[i] ?? String(i + 1).padStart(2, '0')}
            evidenceLabel={p.evidenceLabel}
            ui={p.receiptUi}
            revealDelay={i * 100}
            artifact={i === 0 ? 'translation' : i === 1 ? 'session' : undefined}
          />
        ))
      }
    </div>
  </div>

  <!-- 全页唯一的满宽数字带：三个带凭据的真实数字，每个都能点回上面的回执 -->
  <div class="mt-16 md:mt-20">
    <Ledger />
  </div>
</section>
