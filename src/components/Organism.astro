---
import { getDict } from '../i18n';
const o = getDict(Astro.currentLocale).organism;
---

<section id="organism" class="bg-paper-tint pt-24 pb-24 md:pt-28 md:pb-32">
  <div class="container-site">
    <div class="mx-auto max-w-[33rem] text-center">
      <span class="eyebrow block" data-reveal>{o.eyebrow}</span>
      <h2 class="t-h2 mt-5 text-ink" data-reveal data-reveal-delay="80">{o.heading}</h2>
      <div class="mt-8 space-y-5">
        {o.body.map((b, i) => <p class="t-body text-ink/80" data-reveal data-reveal-delay={160 + i * 80}>{b}</p>)}
      </div>
    </div>

    <!-- 双轨：一条贯穿线上的父级注释（同一批人），线下分出两条平行轨道 -->
    <div
      class="mx-auto mt-16 max-w-2xl"
      data-reveal
      data-reveal-delay={160 + o.body.length * 80 + 40}
    >
      <div class="flex items-center gap-4" aria-hidden="true">
        <span class="h-px flex-1 bg-rule"></span>
        <span class="mono-label whitespace-nowrap text-primary">{o.bridge}</span>
        <span class="h-px flex-1 bg-rule"></span>
      </div>
      <!-- 桥线文字对读屏可见，装饰线才 aria-hidden -->
      <p class="sr-only">{o.bridge}</p>

      <div class="grid grid-cols-1 sm:grid-cols-2">
        {
          o.tracks.map((t, i) => (
            <div
              class:list={[
                'px-4 py-9 text-center sm:px-8',
                i > 0 && 'border-t border-rule sm:border-t-0 sm:border-l',
              ]}
            >
              <p class="t-entry text-ink">{t.name}</p>
              <p class="t-note mt-2.5 text-muted">{t.role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
