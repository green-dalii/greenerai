---
import { getDict } from '../i18n';
const o = getDict(Astro.currentLocale).organism;
---

<section id="organism" class="border-t border-hairline-soft bg-surface-mint py-20 md:py-28">
  <div class="container-site">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow" data-reveal>{o.eyebrow}</span>
      <h2
        class="mt-6 font-display text-3xl font-medium leading-[1.2] tracking-tight text-ink md:text-4xl"
        data-reveal
        data-reveal-delay="80"
      >
        {o.heading}
      </h2>
      <div class="mx-auto mt-8 max-w-2xl space-y-5 text-lg leading-relaxed text-slate">
        {o.body.map((b, i) => (
          <p data-reveal data-reveal-delay={160 + i * 80}>{b}</p>
        ))}
      </div>
      <div
        class="mx-auto mt-10 max-w-md rounded-card border border-white/10 bg-code-bg p-5 text-left shadow-sm"
        data-reveal
        data-reveal-delay={160 + o.body.length * 80 + 80}
      >
        {o.code.map((line, i) => (
          <p
            class:list={[
              'font-mono text-[12.5px] leading-7',
              i === 0 ? 'text-mint-bright' : 'text-muted',
            ]}
          >
            {line}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>