---
import { getDict } from '../i18n';
const r = getDict(Astro.currentLocale).road;
---

<section id="road" class="border-t border-hairline-soft bg-canvas py-20 md:py-28">
  <div class="container-site">
    <div class="mb-12 max-w-2xl">
      <span class="eyebrow" data-reveal>{r.eyebrow}</span>
      <h2 class="display-lg mt-4" data-reveal data-reveal-delay="80">{r.heading}</h2>
      <p class="mt-4 text-base leading-relaxed text-slate" data-reveal data-reveal-delay="160">{r.sub}</p>
    </div>

    <div class="flex flex-wrap gap-3" data-reveal data-reveal-delay="240">
      {r.practices.map((p) => (
        <span
          class="inline-flex items-center gap-2.5 rounded-full border border-mint-soft bg-surface-mint px-5 py-2.5 font-mono text-xs tracking-wide text-primary-deep"
        >
          <i class="h-1.5 w-1.5 rounded-full bg-primary"></i>
          {p}
        </span>
      ))}
    </div>

    <p
      class:list={[
        'mt-14 text-center font-display text-xl leading-snug text-primary md:text-2xl',
        // 中文斜体为合成伪斜，去斜保留颜色强调
        Astro.currentLocale === 'zh' ? 'not-italic' : 'italic',
      ]}
      data-reveal
      data-reveal-delay="320"
    >
      {r.coda}
    </p>
  </div>
</section>
