---
import { getDict } from '../i18n';
const r = getDict(Astro.currentLocale).road;
---

<section id="road" class="border-t border-hairline-soft bg-canvas py-20 md:py-28">
  <div class="container-site">
    <div class="mb-12 max-w-2xl">
      <span class="eyebrow" data-reveal>{r.eyebrow}</span>
      <h2 class="display-lg mt-4" data-reveal data-reveal-delay="80">{r.heading}</h2>
      <p class="mt-5 text-base leading-relaxed text-slate" data-reveal data-reveal-delay="160">{r.sub}</p>
    </div>

    <!-- 三条底线逐行打勾 → coda 收束 -->
    <div class="mx-auto max-w-xl">
      <div
        class="rounded-card border border-hairline-soft bg-surface-mint-soft p-7 md:p-9"
        data-reveal
        data-reveal-delay="240"
      >
        <div class="space-y-6">
          {r.practices.map((p, i) => (
            <div
              class="flex items-center gap-4"
              data-reveal
              data-reveal-delay={280 + i * 90}
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="flex-none text-primary"
                aria-hidden="true"
              >
                <path d="M3 9.5 7.2 13.7 15 4.8" />
              </svg>
              <span class="text-[16px] font-medium text-ink">{p}</span>
            </div>
          ))}
        </div>

        <div class="mt-8 border-t border-hairline pt-7 text-center">
          <p
            class:list={[
              'font-display text-xl leading-snug text-primary md:text-[24px]',
              // 中文斜体为合成伪斜，去斜保留颜色强调
              Astro.currentLocale === 'zh' ? 'not-italic' : 'italic',
            ]}
            data-reveal
            data-reveal-delay="460"
          >
            {r.coda}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>