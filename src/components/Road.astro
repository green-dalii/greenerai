---
import { getDict } from '../i18n';
const r = getDict(Astro.currentLocale).road;
const isZh = Astro.currentLocale === 'zh';
---

<section id="road" class="road-section bg-paper pt-24 pb-20 md:pt-28 md:pb-24">
  <div class="container-site">
    <div class="grid gap-10 md:grid-cols-12 md:gap-x-12">
      <div class="md:col-span-6">
        <span class="eyebrow block" data-reveal>{r.eyebrow}</span>
        <h2 class="t-h2 mt-4 text-ink" data-reveal data-reveal-delay="80">{r.heading}</h2>
        <p class="t-body mt-6 max-w-[32rem] text-ink/85" data-reveal data-reveal-delay="160">
          {r.sub}
        </p>
      </div>

      <!-- 三条底线 + coda：不再包一张薄荷卡片，改为规则线上的三行自检 -->
      <div class="md:col-span-6 md:pl-12">
        <ul class="border-t border-rule-strong" data-reveal data-reveal-delay="240">
          {
            r.practices.map((p, i) => (
              <li class="flex items-baseline gap-4 border-b border-rule py-5">
                {/* 去掉对勾：对勾是信任徽章的语法，而这三行不是「已达成」，是「我们怎么做事」。
                    换成不带评价的序号，读者自己判断。 */}
                <span class="mono-label flex-none text-muted" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="t-body font-medium text-ink">{p}</span>
              </li>
            ))
          }
        </ul>

        <p
          class:list={[
            't-entry mt-9 text-primary',
            isZh ? 'not-italic' : 'italic',
          ]}
          data-reveal
          data-reveal-delay="360"
        >
          {r.coda}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* 这一节的结句是要「破格」的：让 coda 的中文/英文在窄栏里也不至于被挤成两行碎句 */
  .road-section .t-entry {
    text-wrap: balance;
  }
</style>
