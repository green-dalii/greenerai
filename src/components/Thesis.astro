---
import { getDict } from '../i18n';
const t = getDict(Astro.currentLocale).thesis;
---

<!--
  编辑排版的关键动作：层级倒置。
  节标题刻意小于论点陈述 —— 五条信念是本节的主角，不是「See for yourself」的同级兄弟。
  编号 I–IV + 收束符号 ∴（四个支柱 + 一个合成，不是五个并列项）。
  分隔线全出血到视口边缘，正文留在栏内 —— 一次真正的破格。
-->
<section id="thesis" class="thesis-section bg-paper pt-24 pb-14 md:pt-32 md:pb-16">
  <div class="container-site">
    <div class="max-w-[26rem]">
      <span class="eyebrow block" data-reveal>{t.eyebrow}</span>
      <h2 class="t-h2 mt-4 text-ink" data-reveal data-reveal-delay="80">{t.heading}</h2>
    </div>

    <ol class="mt-16 md:mt-20">
      {
        t.items.map((item, i) => (
          <li
            class="thesis-item relative py-10 md:py-14"
            class:list={[item.synthesis ? 'is-synthesis' : '']}
            data-reveal
            data-reveal-delay={i * 60}
          >
            <div class="grid gap-4 md:grid-cols-[8rem_1fr] md:gap-10">
              {item.synthesis ? (
                <span class="synthesis-mark" aria-hidden="true" />
              ) : (
                <span class="numeral-ghost t-numeral select-none" aria-hidden="true">
                  {item.index}
                </span>
              )}
              <div class="min-w-0">
                <h3
                  class:list={[
                    't-statement',
                    item.synthesis ? 'text-primary' : 'text-ink',
                  ]}
                >
                  {item.title}
                </h3>
                <p class="t-body mt-4 max-w-[33rem] text-ink/85 md:mt-5">{item.body}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* 横线出血到视口边缘，文字仍在栏内 */
  .thesis-section {
    overflow-x: clip;
  }
  .thesis-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 1px;
    transform: translateX(-50%);
    background: var(--color-rule);
  }
  /* 收束项的线更重：它是「所以」，不是「第四条之后」 */
  .thesis-item.is-synthesis::before {
    height: 2px;
    background: var(--color-primary);
  }
  /* 合成项的「所以」记号：一条短而重的规则线，取代一个会被误读为装饰的 ∴ */
  .synthesis-mark {
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-top: 1.15rem;
    background: var(--color-primary);
  }

  @media (min-width: 768px) {
    /* 幽灵编号与陈述首行基线对齐 */
    .thesis-item .t-numeral {
      padding-top: 0.12em;
    }
  }
</style>
