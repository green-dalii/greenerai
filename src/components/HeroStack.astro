---
/**
 * 轻量「如今稀缺的」状态面板 —— 一眼可读，无需解释：
 * 知 / 品 / 行 三行（单词 + 一句话注解，无状态徽章，无产品名）。
 * 底部一条杠杆线：you ──► company-scale。
 *
 * 全浅色：白卡 + mint 细线，无深色块。装饰性，aria-hidden。
 * 动效由 motion.ts 的 heroStack() 编排：行交错入场、杠杆线绘制 + mint 脉冲、指针物理按压。
 */
import { getDict } from '../i18n';
const s = getDict(Astro.currentLocale).stack;
---

<div class="stack-stage" data-hero-stack aria-hidden="true">
  <div class="stack" data-hs-tilt>
    <div class="stack-head">
      <span class="stack-head-label">{s.headLabel}</span>
    </div>

    {s.rows.map((l) => (
      <div class="stack-row" data-hs-row>
        <span class="stack-idx">{l.idx}</span>
        <span class="stack-main">
          <span class="stack-name">{l.name}</span>
          <span class="stack-gloss">{l.gloss}</span>
        </span>
      </div>
    ))}

    <div class="stack-lever">
      <span class="lever-label">{s.lever.you}</span>
      <span class="lever-line" data-hs-line>
        <span class="lever-pulse" data-hs-pulse></span>
      </span>
      <span class="lever-label is-accent">{s.lever.companyScale}</span>
    </div>
  </div>
</div>

<style>
  /* 透视舞台：仅作结构容器。透视由 GSAP transformPerspective 内联提供 */
  .stack-stage {
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
  }
  .stack {
    transform-style: preserve-3d;
    --card-lift: 12px;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    /* 微微透明：让背后的版式骨架透出来 —— 「结构，可见」 */
    background: color-mix(in oklab, var(--color-paper) 92%, transparent);
    box-shadow:
      0 1px 0 color-mix(in oklab, var(--color-primary) 5%, transparent),
      0 var(--card-lift, 12px) 28px -18px color-mix(in oklab, var(--color-primary) 22%, transparent);
  }

  .stack-head {
    padding: 13px 18px;
    border-bottom: 1px solid var(--color-rule);
  }
  .stack-head-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stack-row {
    display: grid;
    grid-template-columns: 26px 1fr;
    align-items: center;
    gap: 10px;
    padding: 15px 18px;
  }
  .stack-row + .stack-row {
    border-top: 1px solid var(--color-rule);
  }
  .stack-idx {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
  }
  .stack-main {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }
  .stack-name {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .stack-gloss {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--color-muted);
    text-align: right;
  }

  /* 底部杠杆线 */
  .stack-lever {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px 16px;
    border-top: 1px dashed var(--color-rule-strong);
  }
  .lever-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .lever-label.is-accent {
    color: var(--color-primary);
    font-weight: 600;
  }
  .lever-line {
    flex: 1;
    height: 1.5px;
    border-radius: 1px;
    background: var(--color-rule);
    position: relative;
    overflow: hidden;
    transform-origin: left center;
  }
  .lever-pulse {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 42%;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-primary));
    transform-origin: left center;
  }

  /* 中文：mono 无 CJK 字形 → 回落 sans，避免混排两种质感 */
  html[lang^='zh'] .stack-head-label,
  html[lang^='zh'] .lever-label,
  html[lang^='zh'] .stack-gloss {
    font-family: var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: none;
  }
  html[lang^='zh'] .stack-name {
    font-size: 26px;
    letter-spacing: 0.04em;
  }
</style>
