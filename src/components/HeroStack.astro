---
/**
 * 轻量「如今稀缺的」面板 —— 一眼可读：知 / 品 / 行 三行（单词 + 一句话注解）。
 * 无状态徽章、无 legend、无产品名。装饰性，aria-hidden。
 *
 * 删掉了底部那条「杠杆线」：绿色填充的长度不代表任何东西。
 * 在一个主张「每个数字都可查」的站上放一根装饰性仪表，是自己拆自己的台。
 * 真正的杠杆由实践区的带凭据数字去说，不靠一根虚线仪表。
 *
 * 也删掉了投影：全站只有这一张卡有阴影，它因此不属于这套版式语言。
 */
import { getDict } from '../i18n';
const s = getDict(Astro.currentLocale).stack;
---

<div class="stack-stage" data-hero-stack aria-hidden="true">
  <div class="stack" data-hs-tilt>
    {
      s.rows.map((l) => (
        <div class="stack-row" data-hs-row>
          <span class="stack-idx">{l.idx}</span>
          <span class="stack-name">{l.name}</span>
          <span class="stack-gloss">{l.gloss}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .stack-stage {
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
  }
  .stack {
    transform-style: preserve-3d;
    --card-lift: 0px;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    /* 微微透明：让背后的版式骨架透出来 —— 「结构，可见」 */
    background: color-mix(in oklab, var(--color-paper) 92%, transparent);
    /* 悬停的视觉回报：投影已删（全站唯一的卡不该有阴影），
       改用边框加深承担 —— 与指针按压配合，让「可触碰」这件事有落点。 */
    transition: border-color 0.35s var(--ease-signature, ease);
  }
  .stack:hover {
    border-color: var(--color-rule-strong);
  }
  @media (prefers-reduced-motion: reduce) {
    .stack {
      transition: none;
    }
  }

  /* 三列定宽：序号 │ 名称 │ 注释。
     注释列右对齐 —— 三条注释必须共享同一条右边界，
     原实现里三条的右边缘相差 90px，看起来像没对齐。 */
  .stack-row {
    display: grid;
    /* 注释列必须定宽：auto 会在空间紧张时塌到 min-content，
       把 gloss 挤成一词一行。定宽 + 右对齐 = 三行共享同一条右边界。 */
    grid-template-columns: 24px minmax(0, 1fr) 10.25rem;
    align-items: baseline;
    column-gap: 10px;
    padding: 17px 18px;
  }
  .stack-row + .stack-row {
    border-top: 1px solid var(--color-rule);
  }
  .stack-idx {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
  }
  .stack-name {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .stack-gloss {
    font-family: var(--font-mono);
    /* 10px + 0 字距：24 个字符（"what you've lived through"）刚好落在一行内。
       再宽一点或再大一点，注释就会折成两行、且右对齐的折行非常难看。 */
    font-size: 10px;
    line-height: 1.45;
    letter-spacing: 0;
    color: var(--color-muted);
    text-align: right;
  }

  /* 平板区间（768–1023）：右栏只有约 290px，三列会挤成竖条 → 改为两列上下排 */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .stack-row {
      grid-template-columns: 24px minmax(0, 1fr);
      row-gap: 3px;
    }
    .stack-gloss {
      grid-column: 2;
      text-align: left;
    }
  }

  /* 中文：mono 无 CJK 字形 → 回落 sans，避免混排两种质感 */
  html[lang^='zh'] .stack-gloss {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: none;
  }
  html[lang^='zh'] .stack-name {
    font-size: 26px;
    letter-spacing: 0.04em;
  }
</style>
