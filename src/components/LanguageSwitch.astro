---
import { getDict } from '../i18n';
const dict = getDict(Astro.currentLocale);
const current = Astro.currentLocale;
---

<nav
  class="flex items-center rounded-full border border-hairline bg-surface p-0.5"
  aria-label={dict.langSwitch.label}
>
  <a
    href="/"
    aria-current={current === 'en' ? 'page' : undefined}
    class:list={[
      'rounded-full px-3 py-1.5 font-mono text-[11px] font-medium transition-colors duration-200',
      current === 'en'
        ? 'bg-ink text-white'
        : 'text-steel hover:text-ink',
    ]}
  >
    EN
  </a>
  <a
    href="/zh/"
    aria-current={current === 'zh' ? 'page' : undefined}
    class:list={[
      'rounded-full px-3 py-1.5 font-mono text-[11px] font-medium transition-colors duration-200',
      current === 'zh'
        ? 'bg-ink text-white'
        : 'text-steel hover:text-ink',
    ]}
  >
    中文
  </a>
</nav>
