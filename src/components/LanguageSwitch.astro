---
import { getDict } from '../i18n';
const dict = getDict(Astro.currentLocale);
const current = Astro.currentLocale;
---

<!--
  语言切换：8px 圆角分段控件（遵守禁胶囊按钮红线）。
  触控目标 ≥36px；.mono-label 让 zh 下「中文」回落 sans，避免 mono 无 CJK 字形穿帮。
-->
<nav
  class="flex w-fit items-center gap-0.5 rounded-btn border border-hairline bg-surface p-1"
  aria-label={dict.langSwitch.label}
>
  <a
    href="/"
    aria-current={current === 'en' ? 'page' : undefined}
    class:list={[
      'mono-label rounded-[6px] px-3.5 py-2 text-center text-[11px] font-medium leading-none tracking-wide transition-colors duration-200',
      current === 'en'
        ? 'bg-primary text-white'
        : 'text-steel hover:text-ink',
    ]}
  >
    EN
  </a>
  <a
    href="/zh/"
    aria-current={current === 'zh' ? 'page' : undefined}
    class:list={[
      'mono-label rounded-[6px] px-3.5 py-2 text-center text-[11px] font-medium leading-none tracking-wide transition-colors duration-200',
      current === 'zh'
        ? 'bg-primary text-white'
        : 'text-steel hover:text-ink',
    ]}
  >
    中文
  </a>
</nav>