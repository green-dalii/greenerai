---
import { getDict } from '../i18n';
const dict = getDict(Astro.currentLocale);
const current = Astro.currentLocale;
---

<!--
  语言切换降权：原来是一个绿底白字的分段控件 —— 它是次级控件，却比 logo 还响。
  现在只是一对文字，当前语言用一条下划线标出。导航里最响的东西应该是品牌与章节，不是语言。
  触控目标仍 ≥36px（py-2.5 + text-sm）。
-->
<nav class="lang-switch" aria-label={dict.langSwitch.label}>
  <a
    href="/"
    aria-current={current === 'en' ? 'page' : undefined}
    class:list={['lang-switch-item', current === 'en' && 'is-current']}
  >
    EN
  </a>
  <a
    href="/zh/"
    aria-current={current === 'zh' ? 'page' : undefined}
    class:list={['lang-switch-item', current === 'zh' && 'is-current']}
  >
    中文
  </a>
</nav>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .lang-switch-item {
    position: relative;
    display: inline-block;
    padding: 0.6rem 0;
    font-size: 0.8125rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }
  .lang-switch-item:hover {
    color: var(--color-ink);
  }
  .lang-switch-item.is-current {
    color: var(--color-ink);
  }
  /* 当前语言：一条 2px 下划线，与导航的进度线同一种语言 */
  .lang-switch-item.is-current::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.28rem;
    height: 2px;
    background: var(--color-primary);
  }
</style>