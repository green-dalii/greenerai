---
import type { ProofCardData } from '../i18n/locales/types';
import Receipt from './Receipt.astro';
import Translation from './Translation.astro';
import SessionLog from './SessionLog.astro';

interface Props {
  card: ProofCardData;
  ordinal: string;
  evidenceLabel: string;
  ui: {
    open: string;
    close: string;
    source: string;
    endpoint: string;
    key: string;
    fetched: string;
    verify: string;
  };
  revealDelay?: number;
  /** 实物：这一张卡对应的、可溯源的产品实物 */
  artifact?: 'translation' | 'session';
}

const { card, ordinal, evidenceLabel, ui, revealDelay = 0, artifact } = Astro.props;
---

<!--
  条目而非并排卡片：并排会带来底边参差、统计基线错位，以及「两张卡用两套视觉语法」的矛盾。

  右栏的构成是关键：它是**一整条贯通的凭据边栏**——上端是数字，下端是声称与出口，
  中间那段空白是刻意的栏内留白，而不是「写到一半没东西了」。
  实测过一版把出口留在左栏的做法：右栏内容只用到 365/253px，剩下 334/359px 是空房，
  一条贯穿全高的发丝线右边挂着四行字——读起来就是没做完。
-->
<article
  class="grid gap-y-10 border-t border-rule py-14 md:grid-cols-12 md:gap-x-12 md:py-20"
  data-reveal
  data-reveal-delay={revealDelay}
>
  <!-- 左：身份 + 叙述 + 出口 -->
  <div class="flex flex-col md:col-span-7">
    <div>
      <div class="flex items-baseline gap-3">
        <span class="eyebrow">{card.tag}</span>
        <span class="mono-label text-muted" aria-hidden="true">{ordinal}</span>
      </div>

      <h3 class="t-entry mt-4 text-ink">{card.title}</h3>

      {card.subtag && <p class="mono-label mt-2.5 text-muted">{card.subtag}</p>}

      {
        card.flow && (
          <p class="t-note mt-5 border-l-2 border-primary pl-3.5 text-muted">{card.flow}</p>
        )
      }

      <p class="t-body mt-5 max-w-[33rem] text-ink/85">{card.body}</p>

      {
        artifact && (
          <div class="mt-7 max-w-[33rem]">
            {artifact === 'translation' ? <Translation /> : <SessionLog />}
          </div>
        )
      }
    </div>

  </div>

  <!-- 右：凭据边栏（数字在上，声称与出口在下，中段留白） -->
  <div class="flex flex-col md:col-span-5 md:border-l md:border-rule md:pl-12">
    <p class="mono-label text-muted">{evidenceLabel}</p>

    {
      card.stats.length > 0 && (
        <div class="mt-6 space-y-7">
          {card.stats.map((s) =>
            s.receipt ? (
              <Receipt
                claim={s.value}
                receipt={s.receipt}
                ui={ui}
                triggerClass="t-figure text-ink"
                sublabel={s.label}
                sublabelClass="mono-label text-muted"
                layout="block"
              />
            ) : (
              <div>
                <div class="t-figure text-ink">{s.value}</div>
                <div class="mono-label mt-1.5 text-muted">{s.label}</div>
              </div>
            ),
          )}
        </div>
      )
    }

    <div class="mt-10 md:mt-auto md:pt-10">
      {
        card.claims && card.claims.length > 0 && (
          <ul class="space-y-3.5 border-t border-rule pt-6">
            {card.claims.map((c) => (
              <li class="t-note text-muted">
                <Receipt claim={c.text} receipt={c.receipt} ui={ui} />
              </li>
            ))}
          </ul>
        )
      }

      <a
        href={card.href}
        target="_blank"
        rel="noreferrer"
        class="link-underline t-note mt-8 inline-block font-medium text-primary"
      >
        {card.cta} ↗
      </a>
    </div>
  </div>
</article>
