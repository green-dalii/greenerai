---
import type { ProofCardData } from '../i18n/locales/types';
import Receipt from './Receipt.astro';

interface Props {
  card: ProofCardData;
  ordinal: string;
  evidenceLabel: string;
  ui: {
    open: string;
    close: string;
    source: string;
    endpoint: string;
    key: string;
    fetched: string;
    verify: string;
  };
  revealDelay?: number;
}

const { card, ordinal, evidenceLabel, ui, revealDelay = 0 } = Astro.props;
---

<!--
  条目而非并排卡片：
  并排会带来底边参差、统计基线错位，以及「两张卡用两套视觉语法」的矛盾。
  左栏是身份、叙述与出口；右栏只有凭据 —— 与站点唯一的真实声称（一切可查）同构。
  左栏将出口推到底部（mt-auto），与右栏凭据列表的底边对齐，空白因此成为对齐而非缺口。
-->
<article
  class="grid gap-y-10 border-t border-rule py-14 md:grid-cols-12 md:gap-x-12 md:py-20"
  data-reveal
  data-reveal-delay={revealDelay}
>
  <!-- 左：身份 + 叙述 + 出口 -->
  <div class="flex flex-col md:col-span-7">
    <div>
      <div class="flex items-baseline gap-3">
        <span class="eyebrow">{card.tag}</span>
        <span class="mono-label text-muted" aria-hidden="true">{ordinal}</span>
      </div>

      <h3 class="t-entry mt-4 text-ink">{card.title}</h3>

      {card.subtag && <p class="mono-label mt-2.5 text-muted">{card.subtag}</p>}

      {
        card.flow && (
          <p class="t-note mt-5 border-l-2 border-primary pl-3.5 text-muted">{card.flow}</p>
        )
      }

      <p class="t-body mt-5 max-w-[33rem] text-ink/85">{card.body}</p>
    </div>

    <div class="mt-10 md:mt-auto md:pt-14">
      {
        card.claims && card.claims.length > 0 && (
          <ul class="space-y-2.5">
            {card.claims.map((c) => (
              <li class="t-note text-muted">
                <Receipt claim={c.text} receipt={c.receipt} ui={ui} />
              </li>
            ))}
          </ul>
        )
      }

      <a
        href={card.href}
        target="_blank"
        rel="noreferrer"
        class="link-underline t-note mt-6 inline-block font-medium text-primary"
      >
        {card.cta} ↗
      </a>
    </div>
  </div>

  <!-- 右：凭据 -->
  <div class="md:col-span-5 md:border-l md:border-rule md:pl-12">
    <p class="mono-label text-muted">{evidenceLabel}</p>

    {
      card.stats.length > 0 && (
        <div class="mt-6 space-y-7">
          {card.stats.map((s) =>
            s.receipt ? (
              <Receipt
                claim={s.value}
                receipt={s.receipt}
                ui={ui}
                triggerClass="t-figure text-ink"
                sublabel={s.label}
                sublabelClass="mono-label mt-2 text-muted"
              />
            ) : (
              <div>
                <div class="t-figure text-ink">{s.value}</div>
                <div class="mono-label mt-2 text-muted">{s.label}</div>
              </div>
            ),
          )}
        </div>
      )
    }
  </div>
</article>
