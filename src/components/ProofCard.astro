---
import type { ProofCardData } from '../i18n/locales/types';
interface Props {
  card: ProofCardData;
  featured?: boolean;
  revealDelay?: number;
}
const { card, featured, revealDelay } = Astro.props;
const containerClasses = featured
  ? 'bg-surface-mint border-mint-soft'
  : 'bg-canvas border-hairline-soft';

const revealAttrs =
  typeof revealDelay === 'number'
    ? { 'data-reveal': '', 'data-reveal-delay': revealDelay }
    : {};
---

<a
  href={card.href}
  target="_blank"
  rel="noreferrer"
  class={`group flex h-full flex-col rounded-card border p-8 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_4px_12px_rgba(0,0,0,0.04)] ${containerClasses}`}
  {...revealAttrs}
>
  <span class="eyebrow flex items-center gap-2">
    <span class={`h-1.5 w-1.5 rounded-full ${featured ? 'bg-primary' : 'bg-mint'}`}></span>
    {card.tag}
  </span>
  <h3 class="mt-5 font-display text-2xl text-ink transition-colors group-hover:text-primary">
    {card.title}
  </h3>
  <p class="mt-3 flex-grow text-[15px] leading-relaxed text-slate">{card.body}</p>
  <div class="mt-8 flex flex-wrap items-end gap-x-8 gap-y-4 border-t border-hairline pt-6">
    {card.stats.map((s) => (
      <div>
        {typeof s.countTo === 'number' ? (
          <span
            data-count
            data-count-to={s.countTo}
            data-count-suffix={s.suffix ?? ''}
            class="font-display text-3xl tracking-tight text-ink"
          >
            {s.value}
          </span>
        ) : (
          <div class="font-display text-3xl tracking-tight text-ink">{s.value}</div>
        )}
        <div class="mt-1 font-mono text-[10.5px] uppercase tracking-wider text-steel">{s.label}</div>
      </div>
    ))}
    <span class="ml-auto font-mono text-xs text-primary transition-transform group-hover:translate-x-0.5">
      {card.cta} →
    </span>
  </div>
</a>