---
/**
 * 知识图谱装饰视觉 —— 取意自 obsidian-llm-wiki 的核心机制：
 * 手绘 wiki-link 图 + Personalized PageRank 让笔记变成可查询的知识网络。
 * 全部装饰，无标签，aria-hidden。
 */
---

<div class="graph" data-reveal data-reveal-delay="80" aria-hidden="true">
  <svg
    class="block h-auto w-full"
    viewBox="0 0 520 440"
    xmlns="http://www.w3.org/2000/svg"
    role="presentation"
  >
    <!-- 核心节点的柔光晕 -->
    <circle class="core-glow" cx="260" cy="220" r="48" />

    <!-- 静态边：节点之间的连接骨架 -->
    <g class="edges">
      <line x1="260" y1="220" x2="100" y2="80"  style="--i:0" />
      <line x1="260" y1="220" x2="210" y2="50"  style="--i:1" />
      <line x1="260" y1="220" x2="350" y2="70"  style="--i:2" />
      <line x1="260" y1="220" x2="450" y2="160" style="--i:3" />
      <line x1="260" y1="220" x2="470" y2="260" style="--i:4" />
      <line x1="260" y1="220" x2="430" y2="360" style="--i:5" />
      <line x1="260" y1="220" x2="310" y2="400" style="--i:6" />
      <line x1="260" y1="220" x2="180" y2="410" style="--i:7" />
      <line x1="260" y1="220" x2="70"  y2="350" style="--i:8" />
      <line x1="260" y1="220" x2="50"  y2="220" style="--i:9" />
      <line x1="260" y1="220" x2="130" y2="150" style="--i:10" />
      <line x1="260" y1="220" x2="390" y2="240" style="--i:11" />
      <line x1="100" y1="80"  x2="210" y2="50"  style="--i:12" />
      <line x1="350" y1="70"  x2="450" y2="160" style="--i:13" />
      <line x1="430" y1="360" x2="310" y2="400" style="--i:14" />
      <line x1="180" y1="410" x2="70"  y2="350" style="--i:15" />
    </g>

    <!-- 三条「查询进行中」的轨迹：在静态边之上滑动的 mint 色虚线 -->
    <g class="queries">
      <line class="query q1" x1="260" y1="220" x2="350" y2="70" />
      <line class="query q2" x1="260" y1="220" x2="430" y2="360" />
      <line class="query q3" x1="260" y1="220" x2="70"  y2="350" />
    </g>

    <!-- 节点（最上层）：核心 + 12 卫星 -->
    <g class="nodes">
      <!-- 核心：脉冲环 + 实心圆 -->
      <circle class="core-ring" cx="260" cy="220" r="22" />
      <circle class="core" cx="260" cy="220" r="13" />

      <!-- 卫星：data-float 带来轻柔漂浮；fill/fill-opacity 内联 -->
      <circle data-float style="--float-delay:0ms"    cx="100" cy="80"  r="4" fill="#34d399" fill-opacity="0.85" />
      <circle data-float style="--float-delay:200ms"  cx="210" cy="50"  r="3" fill="#68fcbf" fill-opacity="0.7"  />
      <circle data-float style="--float-delay:350ms"  cx="350" cy="70"  r="5" fill="#0a6c4b" fill-opacity="0.9"  />
      <circle data-float style="--float-delay:500ms"  cx="450" cy="160" r="4" fill="#34d399" fill-opacity="0.8"  />
      <circle data-float style="--float-delay:650ms"  cx="470" cy="260" r="3" fill="#68fcbf" fill-opacity="0.65" />
      <circle data-float style="--float-delay:800ms"  cx="430" cy="360" r="5" fill="#0a6c4b" fill-opacity="0.85" />
      <circle data-float style="--float-delay:950ms"  cx="310" cy="400" r="4" fill="#34d399" fill-opacity="0.75" />
      <circle data-float style="--float-delay:1100ms" cx="180" cy="410" r="3" fill="#68fcbf" fill-opacity="0.7"  />
      <circle data-float style="--float-delay:1250ms" cx="70"  cy="350" r="5" fill="#0a6c4b" fill-opacity="0.9"  />
      <circle data-float style="--float-delay:1400ms" cx="50"  cy="220" r="4" fill="#34d399" fill-opacity="0.8"  />
      <circle data-float style="--float-delay:175ms"  cx="130" cy="150" r="3" fill="#0a6c4b" fill-opacity="0.6"  />
      <circle data-float style="--float-delay:425ms"  cx="390" cy="240" r="3" fill="#34d399" fill-opacity="0.55" />
    </g>
  </svg>
</div>

<style>
  .graph {
    color: #0a6c4b;
  }

  /* 静态边：先全部隐藏，等 .is-in 后按 --i 序号交错绘出 */
  .edges line {
    stroke: #0a6c4b;
    stroke-width: 1;
    stroke-opacity: 0.22;
    stroke-linecap: round;
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
  }
  @keyframes draw-edge {
    to {
      stroke-dashoffset: 0;
    }
  }
  .graph.is-in .edges line {
    animation: draw-edge 1s ease forwards;
    animation-delay: calc(var(--i, 0) * 40ms);
  }

  /* 「查询进行中」的轨迹：淡入后沿路径无限滑行 */
  .query {
    stroke: #34d399;
    stroke-width: 1.5;
    stroke-opacity: 0.9;
    stroke-linecap: round;
    stroke-dasharray: 4 10;
    opacity: 0;
  }
  @keyframes query-fadein {
    to {
      opacity: 1;
    }
  }
  @keyframes query-travel {
    to {
      stroke-dashoffset: -28;
    }
  }
  .graph.is-in .query {
    animation:
      query-fadein 0.6s ease 1.5s forwards,
      query-travel 2.6s linear 1.7s infinite;
  }
  .graph.is-in .query.q2 {
    animation-duration: 0.6s, 3.2s;
    animation-direction: normal, reverse;
  }
  .graph.is-in .query.q3 {
    animation-duration: 0.6s, 2.9s;
  }

  /* 核心节点的呼吸式脉冲 */
  .core-glow {
    fill: #34d399;
    opacity: 0.14;
  }
  .core {
    fill: #0a6c4b;
  }
  .core-ring {
    fill: none;
    stroke: #0a6c4b;
    stroke-opacity: 0.45;
    stroke-width: 1.5;
    transform-origin: 260px 220px;
    transform-box: fill-box;
  }
  @keyframes core-pulse {
    0% {
      transform: scale(0.85);
      stroke-opacity: 0.55;
    }
    100% {
      transform: scale(2.1);
      stroke-opacity: 0;
    }
  }
  .graph.is-in .core-ring {
    animation: core-pulse 3.4s ease-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .edges line {
      stroke-dashoffset: 0;
      animation: none;
    }
    .query {
      opacity: 1;
      animation: none;
    }
    .core-ring {
      animation: none;
      stroke-opacity: 0.25;
    }
  }
</style>