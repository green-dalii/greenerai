---
import Brand from './Brand.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { getDict } from '../i18n';
const dict = getDict(Astro.currentLocale);

const links = [
  { href: '#thesis', label: dict.nav.thesis },
  { href: '#proof', label: dict.nav.proof },
  { href: '#organism', label: dict.nav.organism },
  { href: '#road', label: dict.nav.road },
];
---

<!--
  Header UX（参考 deepseek.com/harness）：
  顶部 = 全宽透明，悬浮在 hero 网格之上；
  下滑 = 横向收缩为居中半透明胶囊（backdrop-blur + 细边 + 轻投影），内高同步收窄。
  全部由 .nav-shell 的 max-width/bg/radius 过渡完成，无跳变。
-->
<header data-header class="fixed inset-x-0 top-0 z-50">
  <div class="nav-shell">
    <div class="nav-inner">
      <Brand />

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="link-underline text-sm text-slate transition-colors duration-200 hover:text-ink"
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={dict.nav.githubHref}
          target="_blank"
          rel="noreferrer"
          class="hidden text-sm font-medium text-primary transition-colors duration-200 hover:text-primary-deep lg:block"
        >
          {dict.nav.github}
        </a>
        <LanguageSwitch />
        <button
          type="button"
          class="grid h-9 w-9 place-items-center rounded-md border border-hairline text-slate transition-colors duration-200 hover:bg-surface lg:hidden"
          aria-label={dict.nav.menuLabel}
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          >
            <line x1="2" y1="4" x2="14" y2="4"></line>
            <line x1="2" y1="8" x2="14" y2="8"></line>
            <line x1="2" y1="12" x2="14" y2="12"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-hairline-soft bg-canvas/95 backdrop-blur-xl lg:hidden"
    data-menu
    aria-hidden="true"
  >
    <nav
      class="container-site flex flex-col py-4"
      aria-label="Primary mobile"
    >
      {
        links.map((l) => (
          <a
            href={l.href}
            class="border-b border-hairline-soft py-3 text-sm text-slate last:border-b-0 hover:text-ink"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={dict.nav.githubHref}
        target="_blank"
        rel="noreferrer"
        class="py-3 text-sm font-medium text-primary"
      >
        {dict.nav.github}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openMenu = () => {
    menu?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    menu?.setAttribute('aria-hidden', 'false');
  };
  const closeMenu = () => {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
  };
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.contains('hidden');
      open ? openMenu() : closeMenu();
    });
    // 锚点跳转后收起
    menu.querySelectorAll('a[href^="#"]').forEach((a) =>
      a.addEventListener('click', closeMenu),
    );
    // 点击菜单外关闭
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!menu.contains(t) && !toggle.contains(t)) closeMenu();
    });
    // Escape 关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  }

  // 滚动状态：顶部透明全宽 → 下滑收缩为半透明胶囊。
  // 阈值加高（>80 进入，<40 离开，中间 40px 滞回带）—— 不再一滑就缩
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let scrolled = window.scrollY > 80;
    header.classList.toggle('is-scrolled', scrolled);
    const update = () => {
      const sy = window.scrollY;
      if (!scrolled && sy > 80) scrolled = true;
      else if (scrolled && sy < 40) scrolled = false;
      header.classList.toggle('is-scrolled', scrolled);
    };
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  /* 顶部态：透明、全宽（1280 容器） */
  [data-header] {
    padding-top: 0;
    transition: padding 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-shell {
    margin-inline: auto;
    margin-top: 0;
    max-width: 1280px;
    padding: 9px 24px; /* 垂直 padding 固定 —— 不上下漂；仅水平 padding 在收缩时变化 */
    border-radius: 0;
    border: 1px solid transparent; /* 始终透明边框：收缩态也保持，避免尺寸跳变 */
    background: transparent;
    /* blur(0) 而非 none：保证 backdrop-filter 可插值过渡，不瞬跳 */
    backdrop-filter: blur(0px) saturate(1);
    -webkit-backdrop-filter: blur(0px) saturate(1);
    /* 收缩方向（下滑）：宽度、margin-top (8px 露出顶部空隙)、玻璃同时 0.8s 推进。
       Material standard easing (0.4,0,0.2,1) —— 全程平滑加减速，无初始冲量、无弹 */
    transition:
      max-width 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      margin-top 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 0.75s cubic-bezier(0.4, 0, 0.2, 1) 0.02s,
      background-color 0.8s ease,
      backdrop-filter 0.8s ease,
      box-shadow 0.8s ease;
  }

  /* 扩展方向（回顶部）：玻璃最先消失（0.35s 无延迟），宽度 1.4s 缓伸 ——
     Material standard 让末段减速可见，体感上“逐渐停止” */
  [data-header]:not(.is-scrolled) .nav-shell {
    transition:
      max-width 1.4s cubic-bezier(0.4, 0, 0.2, 1),
      margin-top 1.1s cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 1.25s cubic-bezier(0.4, 0, 0.2, 1) 0.04s,
      background-color 0.35s ease 0s,
      backdrop-filter 0.4s ease 0s,
      box-shadow 0.35s ease 0s;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 下滑态：居中半透明胶囊，纯横向收缩（Y 轴不动） */
  [data-header].is-scrolled {
    /* 纯横向形变：padding-top 保持 0，不上下浮 */
  }
  [data-header].is-scrolled .nav-shell {
    max-width: 680px;
    padding: 9px 24px; /* 水平 padding 与顶部一致 — 胶囊不太瘪 */
    margin-top: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(20px) saturate(1.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    box-shadow:
      0 12px 40px rgba(10, 108, 75, 0.1),
      0 2px 8px rgba(0, 0, 0, 0.04);
  }
  [data-header].is-scrolled .nav-inner {
    height: 52px; /* 内高不变 */
  }

  @media (prefers-reduced-motion: reduce) {
    [data-header],
    .nav-shell,
    .nav-inner {
      transition: none;
    }
  }
</style>
