---
import Brand from './Brand.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { getDict } from '../i18n';
const dict = getDict(Astro.currentLocale);

const links = [
  { href: '#thesis', label: dict.nav.thesis },
  { href: '#proof', label: dict.nav.proof },
  { href: '#organism', label: dict.nav.organism },
  { href: '#road', label: dict.nav.road },
];
---

<!--
  Header：全宽发丝线栏 + 滚动进度线。
  删掉了「下滑收缩成居中不透明胶囊」—— 680px 的白胶囊会压在正文标题上，
  且在创意维度是最容易辨认的模板特征。全宽零遮挡更编辑、更克制。
-->
<header data-header class="fixed inset-x-0 top-0 z-50">
  <div class="nav-surface">
    <div class="container-site nav-inner">
      <Brand />

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
        {
          links.map((l) => (
            <a
              href={l.href}
              data-nav-link={l.href}
              class="nav-link"
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={dict.nav.githubHref}
          target="_blank"
          rel="noreferrer"
          class="hidden text-sm font-medium text-primary transition-opacity duration-200 hover:opacity-70 lg:block"
        >
          {dict.nav.github}
        </a>
        <LanguageSwitch />
        <button
          type="button"
          class="grid h-9 w-9 place-items-center rounded-btn border border-rule text-muted transition-colors duration-200 hover:border-rule-strong hover:text-ink lg:hidden"
          aria-label={dict.nav.menuLabel}
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="2" y1="5" x2="14" y2="5"></line>
            <line x1="2" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>
      </div>
    </div>
    <!-- 阅读进度：一条 primary 发丝，替代胶囊收缩作为滚动反馈 -->
    <div class="nav-progress" data-nav-progress aria-hidden="true"></div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-rule bg-paper/96 backdrop-blur-xl lg:hidden"
    data-menu
    aria-hidden="true"
  >
    <nav class="container-site flex flex-col py-4" aria-label="Primary mobile">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="border-b border-rule py-3 text-sm text-muted last:border-b-0 hover:text-ink"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={dict.nav.githubHref}
        target="_blank"
        rel="noreferrer"
        class="py-3 text-sm font-medium text-primary"
      >
        {dict.nav.github}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openMenu = () => {
    menu?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    menu?.setAttribute('aria-hidden', 'false');
  };
  const closeMenu = () => {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
  };
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.contains('hidden') ? openMenu() : closeMenu();
    });
    menu.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', closeMenu));
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!menu.contains(t) && !toggle.contains(t)) closeMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  }

  // 滚动状态 + 阅读进度（rAF 节流，passive）
  const header = document.querySelector<HTMLElement>('[data-header]');
  const progress = document.querySelector<HTMLElement>('[data-nav-progress]');
  if (header) {
    let ticking = false;
    const update = () => {
      const sy = window.scrollY;
      header.classList.toggle('is-scrolled', sy > 24);
      if (progress) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(1, Math.max(0, sy / max)) : 0;
        progress.style.transform = `scaleX(${p})`;
      }
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>

<style>
  /* 顶部态：全宽、透明、无边框 —— 与 hero 纸面同色，只留一条发丝做分界 */
  .nav-surface {
    position: relative;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.32s ease,
      border-color 0.32s ease;
  }
  [data-header].is-scrolled .nav-surface {
    background: color-mix(in oklab, var(--color-paper) 86%, transparent);
    border-bottom-color: var(--color-rule);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  /* 阅读进度：底部 2px 发丝，scaleX 驱动（不触发 layout） */
  .nav-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    transition: opacity 0.32s ease;
    pointer-events: none;
  }
  [data-header].is-scrolled .nav-progress {
    opacity: 1;
  }

  /* 导航项：默认 muted；当前节转 ink 并落一条 2px 底线。
     与语言切换的当前态用同一种记号 —— 整个 header 只有一种「你在这里」的信号。 */
  .nav-link {
    position: relative;
    padding: 0.35rem 0;
    font-size: 0.875rem;
    color: var(--color-muted);
    transition: color 0.2s var(--ease-signature, ease);
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-link[data-active] {
    color: var(--color-ink);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.05rem;
    height: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.32s var(--ease-signature, ease);
  }
  .nav-link[data-active]::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-surface,
    .nav-progress,
    .nav-link::after {
      transition: none;
    }
  }
</style>
