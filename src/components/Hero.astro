---
import { getDict } from '../i18n';
import HeroStack from './HeroStack.astro';

const d = getDict(Astro.currentLocale).hero;
---

<section class="mesh-hero relative overflow-hidden">
  <!-- ASCII 像素点背景：canvas 点阵 (`·`/JetBrains Mono)，指针热区变亮+变字符 -->
  <canvas id="hero-ascii" class="hero-ascii" aria-hidden="true"></canvas>

  <div
    class="container-site relative z-10 grid grid-cols-1 items-center gap-12 pt-24 pb-16 md:grid-cols-12 md:gap-10 md:pt-28 md:pb-24 lg:pt-32 lg:pb-28"
  >
    <!-- Left: editorial manifesto -->
    <div class="md:col-span-7">
      <span class="hero-eyebrow" data-reveal>
        <span class="hero-eyebrow-dot" aria-hidden="true"></span>
        {d.eyebrow}
      </span>

      <h1
        class="mt-7 font-display text-[30px] leading-[1.18] tracking-[-0.01em] text-ink sm:text-[36px] md:text-[42px] lg:text-[48px]"
      >
        <span class="hero-line-mask block">
          <span class="hero-line-inner block text-balance" data-hero-line>{d.h1a}</span>
        </span>
        <span class="hero-line-mask block">
          <span
            class="hero-line-inner block text-balance"
            data-hero-line
            data-hero-line-delay="140"
          >
            <!-- 中文斜体是合成伪斜（Instrument Serif 无 CJK 字形），中文只用颜色强调 -->
            <em
              class:list={[
                'text-primary',
                Astro.currentLocale === 'zh' ? 'not-italic' : 'italic',
              ]}
              >{d.h1b}</em
            >
          </span>
        </span>
      </h1>

      <p
        class="mt-7 max-w-xl text-base leading-relaxed text-slate md:text-[17px]"
        data-reveal
        data-reveal-delay="240"
      >
        {d.sub}
      </p>

      <div
        class="mt-9 flex flex-col gap-3 sm:flex-row"
        data-reveal
        data-reveal-delay="320"
      >
        <a class="btn-primary" href={d.ctaPrimaryHref}>{d.ctaPrimary}</a>
        <a
          class="btn-secondary"
          href={d.ctaSecondaryHref}
          target="_blank"
          rel="noreferrer">{d.ctaSecondary}</a
        >
      </div>

      <p
        class="mt-6 font-mono text-[10.5px] uppercase tracking-[0.14em] text-steel"
        data-reveal
        data-reveal-delay="380"
      >
        {d.footnote}
      </p>
    </div>

    <!-- Right: the stack, at a glance -->
    <div class="md:col-span-5">
      <HeroStack />
      <p
        class="mt-5 text-center font-mono text-[10.5px] uppercase tracking-[0.16em] text-steel"
        data-reveal
        data-reveal-delay="300"
      >
        {d.stackCaption}
      </p>
    </div>
  </div>
</section>
