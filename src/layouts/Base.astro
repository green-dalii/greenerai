---
import '../styles/global.css';
// 自托管字体（@fontsource，latin 子集）—— 替代 Google Fonts 渲染阻塞
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getDict } from '../i18n';

const dict = getDict(Astro.currentLocale);
const lang = Astro.currentLocale === 'zh' ? 'zh-CN' : 'en';
const isZh = Astro.currentLocale === 'zh';

const siteUrl = 'https://greenerai.top';
const canonical = new URL(Astro.url.pathname, Astro.site);
const hreflangEn = new URL('/', Astro.site).toString();
const hreflangZh = new URL('/zh/', Astro.site).toString();
const ldLang = isZh ? 'zh-CN' : 'en-US';

// JSON-LD —— 机器可读实体（LLM 引擎/GEO 关键）
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Greener-Dalii',
  alternateName: '格润达理',
  url: siteUrl + '/',
  logo: siteUrl + '/logomark.svg',
  description: dict.meta.description,
  knowsAbout: ['leverage for the AI-native era', 'local-first knowledge tools', 'model routing for coding agents', 'open source'],
  industry: 'Software',
  sameAs: [
    'https://github.com/green-dalii',
    'https://greenerdalii.top',
    'https://github.com/green-dalii/obsidian-llm-wiki',
    'https://github.com/green-dalii/pi-shift-router',
  ],
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Greener-Dalii',
  url: siteUrl + '/',
  inLanguage: ldLang,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{dict.meta.title}</title>
    <meta name="description" content={dict.meta.description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#0a6c4b" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href="/llms.txt" />

    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="zh-CN" href={hreflangZh} />
    <link rel="alternate" hreflang="x-default" href={hreflangEn} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Greener-Dalii" />
    <meta property="og:title" content={dict.meta.ogTitle} />
    <meta property="og:description" content={dict.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={siteUrl + '/og-image.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.ogTitle} />
    <meta property="og:locale" content={isZh ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={isZh ? 'en_US' : 'zh_CN'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={dict.meta.ogTitle} />
    <meta name="twitter:description" content={dict.meta.ogDescription} />
    <meta name="twitter:image" content={siteUrl + '/og-image.png'} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)}></script>

    <!-- 早期标记 js：无 JS 时 [data-reveal] 保持可见（不做 .js 门控） -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <noscript><style>[data-reveal]{opacity:1 !important}</style></noscript>
  </head>
  <body>
    <Nav />
    <main><slot /></main>
    <Footer />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
