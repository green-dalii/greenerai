---
import '../styles/global.css';
// 自托管字体（@fontsource，latin 子集）—— 替代 Google Fonts 渲染阻塞
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
/* 预加载首屏 LCP 字体。Instrument Serif 只用于 display 字号（H1 100px），
   它晚到 300ms 就是一次肉眼可见的字体重排；preload 让它与 CSS 并行下载。 */
import serifRoman from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getDict } from '../i18n';

/* 允许页面覆写 head —— 404 需要自己的 title / description / noindex。
   不传时行为与以前完全一致（全站文案仍以字典为唯一来源）。 */
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

const dict = getDict(Astro.currentLocale);
const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;
const lang = Astro.currentLocale === 'zh' ? 'zh-CN' : 'en';
const isZh = Astro.currentLocale === 'zh';

const siteUrl = 'https://greenerai.top';
const canonical = new URL(Astro.url.pathname, Astro.site);
const hreflangEn = new URL('/', Astro.site).toString();
const hreflangZh = new URL('/zh/', Astro.site).toString();
const ldLang = isZh ? 'zh-CN' : 'en-US';
// 分享卡按语言各一张 —— 与站点同一套 token / 字体 / 口号渲染（源：/og-card、/zh/og-card）
const ogImage = siteUrl + (isZh ? '/og-image-zh.jpg' : '/og-image.jpg');

// JSON-LD —— 机器可读实体（LLM 引擎/GEO 关键）
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Greener-Dalii',
  alternateName: '格润达理',
  url: siteUrl + '/',
  logo: siteUrl + '/logomark.svg',
  description: dict.meta.description,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'hi@greenerai.top',
    availableLanguage: ['English', 'zh-Hans'],
  },
  knowsAbout: ['leverage for the AI-native era', 'local-first knowledge tools', 'model routing for coding agents', 'open source'],
  industry: 'Software',
  sameAs: [
    'https://github.com/green-dalii',
    'https://greenerdalii.top',
    // 仓库已迁至 GD4AI（旧路径 301 指过去，但实体声明要用规范地址）
    'https://github.com/GD4AI/obsidian-llm-wiki',
    'https://github.com/green-dalii/pi-shift-router',
    'https://github.com/green-dalii/dsh-shift-router',
    'https://llmwiki.greenerai.top',
    'https://shiftrouter.greenerai.top',
    'https://x.com/greenerdalii',
  ],
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Greener-Dalii',
  url: siteUrl + '/',
  inLanguage: ldLang,
};
// GEO 关键：让 LLM 拿到两个产品的机器可读字段（license / 价格 / 来源 / 同件）
const productLd = (name: string, url: string, license: string, repoUrl: string, description: string) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  url,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cross-platform',
  license,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  codeRepository: repoUrl,
  publisher: { '@type': 'Organization', name: 'Greener-Dalii', url: siteUrl + '/' },
  description,
});
const karpathyWikiLd = productLd(
  'Karpathy LLM Wiki',
  'https://llmwiki.greenerai.top/',
  'Apache-2.0',
  'https://github.com/green-dalii/obsidian-llm-wiki',
  "Karpathy's LLM Wiki, rebuilt as an Obsidian plugin. Your notes become a knowledge base that answers — every answer cites its source, nothing leaves your machine.",
);
const shiftRouterLd = productLd(
  'Shift-Router',
  'https://shiftrouter.greenerai.top/',
  'MIT',
  'https://github.com/green-dalii/pi-shift-router',
  'Task-level router for coding agents. Every turn is triaged, instant upgrades when it counts, same-turn failover on rate limits. One brand, two hosts (Pi & DeepSeek Harness).',
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {
      noindex ? (
        <meta name="robots" content="noindex,follow" />
      ) : (
        <meta name="robots" content="index,follow,max-image-preview:large" />
      )
    }
    <meta name="theme-color" content="#0a6c4b" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preload" as="font" type="font/woff2" href={serifRoman} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={serifItalic} crossorigin />

    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={hreflangEn} />
          <link rel="alternate" hreflang="zh-CN" href={hreflangZh} />
          <link rel="alternate" hreflang="x-default" href={hreflangEn} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Greener-Dalii" />
    <meta property="og:title" content={dict.meta.ogTitle} />
    <meta property="og:description" content={dict.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.ogTitle} />
    <meta property="og:locale" content={isZh ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={isZh ? 'en_US' : 'zh_CN'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@greenerdalii" />
    <meta name="twitter:title" content={dict.meta.ogTitle} />
    <meta name="twitter:description" content={dict.meta.ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={dict.meta.ogTitle} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(karpathyWikiLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(shiftRouterLd)}></script>

    <!-- 注意：内容隐藏由 motion.ts 成功初始化后加上的 .motion-ready 门控。
         无 JS / 脚本失败 → 不加该类 → 内容保持可见（不会再出现整页空白）。 -->
  </head>
  <body>
    <Nav />
    <main><slot /></main>
    <Footer />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
